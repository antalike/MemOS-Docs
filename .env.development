# Loaded by `next dev` (local development).
# Points at pre backends — set memos_token_dev in DevTools if testing API Key.
NEXT_PUBLIC_APP_ENV=dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=https://apigw.memtensor.cn
NEXT_PUBLIC_DASHBOARD_API_BASE=https://apigw-pre.memtensor.cn
NEXT_PUBLIC_DASHBOARD_URL=https://memos-dashboard-pre.openmem.net
NEXT_PUBLIC_AUTH_COOKIE_NAME=memos_token_dev
